        },
        "when": "advanced_ae"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "neoecoae:block/large_integrated_working_station_compat/extendedae_off"
        },
        "when": "extendedae"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "neoecoae:block/large_integrated_working_station_compat/ae2cs_off"
        },
        "when": "ae2cs"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "neoecoae:block/large_integrated_working_station_compat/aelt_off"
        },
        "when": "aelt"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "neoecoae:block/large_integrated_working_station_compat/other_off"
        },
        "when": "other"
      },
      {
        "model": {
          "type": "minecraft:model",
          "model": "neoecoae:block/large_integrated_working_station_compat/data_energistics_off"
